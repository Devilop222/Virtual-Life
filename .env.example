# Environment
NODE_ENV=development

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtual_life

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# HTTP port for the lightweight health check endpoint
PORT=8080
HEALTH_PATH=/health

# Game rules
GAME_START_AGE=18
GAME_MAX_AGE=120

# Brand: Legacy Game — میراث
# Optional — Telegram sticker file_id sent when a character is born.
# Get it by forwarding a sticker to @userbotinfobot or via your own upload bot.
MILESTONE_STICKER_FILE_ID=